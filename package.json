{
  "name": "ossm-configurator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run prepare:assets",
    "dev": "vite",
    "prebuild": "npm run prepare:assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "catalog:build": "node scripts/compile-catalog.mjs",
    "models:prepare": "node scripts/prepare-models.mjs",
    "prepare:assets": "npm run catalog:build && npm run models:prepare",
    "pretypecheck": "npm run catalog:build",
    "typecheck": "tsc -b",
    "prelint": "npm run catalog:build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run catalog:build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "ajv": "^8.17.1",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
